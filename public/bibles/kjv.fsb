["kjv",{"name":"King James Version","metadata":{},"copyright":"Public Domain","books":[{"number":1,"customName":"Genesis","name":"Genesis","abbreviation":"Gen","chapters":[{"number":1,"verses":[{"number":1,"text":"In the beginning God created the heaven and the earth."},{"number":27,"text":"So God created man in his own image, in the image of God created he him; male and female created he them."}]}]},{"number":2,"customName":"Exodus","name":"Exodus","abbreviation":"Exod","chapters":[{"number":20,"verses":[{"number":3,"text":"Thou shalt have no other gods before me."},{"number":12,"text":"Honour thy father and thy mother: that thy days may be long upon the land which the LORD thy God giveth thee."}]}]},{"number":3,"customName":"Leviticus","name":"Leviticus","abbreviation":"Lev","chapters":[{"number":19,"verses":[{"number":18,"text":"Thou shalt not avenge, nor bear any grudge against the children of thy people, but thou shalt love thy neighbour as thyself: I am the LORD."}]}]},{"number":19,"customName":"Psalms","name":"Psalms","abbreviation":"Ps","chapters":[{"number":23,"verses":[{"number":1,"text":"The LORD is my shepherd; I shall not want."},{"number":4,"text":"Yea, though I walk through the valley of the shadow of death, I will fear no evil: for thou art with me; thy rod and thy staff they comfort me."}]},{"number":46,"verses":[{"number":1,"text":"God is our refuge and strength, a very present help in trouble."}]},{"number":119,"verses":[{"number":105,"text":"Thy word is a lamp unto my feet, and a light unto my path."}]}]},{"number":23,"customName":"Isaiah","name":"Isaiah","abbreviation":"Isa","chapters":[{"number":40,"verses":[{"number":31,"text":"But they that wait upon the LORD shall renew their strength; they shall mount up with wings as eagles; they shall run, and not be weary; and they shall walk, and not faint."}]},{"number":53,"verses":[{"number":5,"text":"But he was wounded for our transgressions, he was bruised for our iniquities: the chastisement of our peace was upon him; and with his stripes we are healed."}]},{"number":55,"verses":[{"number":11,"text":"So shall my word be that goeth forth out of my mouth: it shall not return unto me void, but it shall accomplish that which I please, and it shall prosper in the thing whereto I sent it."}]}]},{"number":43,"customName":"John","name":"John","abbreviation":"John","chapters":[{"number":1,"verses":[{"number":1,"text":"In the beginning was the Word, and the Word was with God, and the Word was God."}]},{"number":3,"verses":[{"number":16,"text":"For God so loved the world, that he gave his only begotten Son, that whosoever believeth in him should not perish, but have everlasting life."},{"number":3,"text":"Jesus answered and said unto him, Verily, verily, I say unto thee, Except a man be born again, he cannot see the kingdom of God."}]},{"number":14,"verses":[{"number":6,"text":"Jesus saith unto him, I am the way, the truth, and the life: no man cometh unto the Father, but by me."},{"number":27,"text":"Peace I leave with you, my peace I give unto you: not as the world giveth, give I unto you. Let not your heart be troubled, neither let it be afraid."}]}]},{"number":44,"customName":"Acts","name":"Acts","abbreviation":"Acts","chapters":[{"number":1,"verses":[{"number":8,"text":"But ye shall receive power, after that the Holy Ghost is come upon you: and ye shall be witnesses unto me both in Jerusalem, and in all Judaea, and in Samaria, and unto the uttermost part of the earth."}]}]},{"number":45,"customName":"Romans","name":"Romans","abbreviation":"Rom","chapters":[{"number":3,"verses":[{"number":23,"text":"For all have sinned, and come short of the glory of God;"}]},{"number":5,"verses":[{"number":8,"text":"But God commendeth his love toward us, in that, while we were yet sinners, Christ died for us."}]},{"number":6,"verses":[{"number":23,"text":"For the wages of sin is death; but the gift of God is eternal life through Jesus Christ our Lord."}]},{"number":8,"verses":[{"number":28,"text":"And we know that all things work together for good to them that love God, to them who are the called according to his purpose."}]},{"number":10,"verses":[{"number":9,"text":"That if thou shalt confess with thy mouth the Lord Jesus, and shalt believe in thine heart that God hath raised him from the dead, thou shalt be saved."}]}]},{"number":46,"customName":"1 Corinthians","name":"1 Corinthians","abbreviation":"1 Cor","chapters":[{"number":13,"verses":[{"number":4,"text":"Charity suffereth long, and is kind; charity envieth not; charity vaunteth not itself, is not puffed up,"},{"number":5,"text":"Doth not behave itself unseemly, seeketh not her own, is not easily provoked, thinketh no evil;"},{"number":7,"text":"Rejoiceth not in iniquity, but rejoiceth in the truth; Beareth all things, believeth all things, hopeth all things, endureth all things."}]}]},{"number":50,"customName":"Philippians","name":"Philippians","abbreviation":"Phil","chapters":[{"number":4,"verses":[{"number":13,"text":"I can do all things through Christ which strengtheneth me."}]}]},{"number":65,"customName":"1 John","name":"1 John","abbreviation":"1 John","chapters":[{"number":1,"verses":[{"number":9,"text":"If we confess our sins, he is faithful and just to forgive us our sins, and to cleanse us from all unrighteousness."}]},{"number":4,"verses":[{"number":8,"text":"He that loveth not knoweth not God; for God is love."},{"number":19,"text":"We love him, because he first loved us."}]}]},{"number":66,"customName":"Revelation","name":"Revelation","abbreviation":"Rev","chapters":[{"number":21,"verses":[{"number":4,"text":"And God shall wipe away all tears from their eyes; and there shall be no more death, neither sorrow, nor crying, neither shall there be any more pain: for the former things are passed away."}]}]}]}