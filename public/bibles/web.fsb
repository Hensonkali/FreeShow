["web","World English Bible",{"metadata":{},"copyright":"Public Domain","books":[{"number":1,"customName":"Genesis","name":"Genesis","abbreviation":"Gen","chapters":[{"number":1,"verses":[{"number":1,"text":"In the beginning God created the heavens and the earth."},{"number":27,"text":"So God created man in his own image; in the image of God he created him; male and female he created them."}]}]},{"number":19,"customName":"Psalms","name":"Psalms","abbreviation":"Ps","chapters":[{"number":23,"verses":[{"number":1,"text":"Yahweh is my shepherd; I shall not want."},{"number":4,"text":"Even though I walk through the valley of the shadow of death, I will fear no evil, for you are with me; your rod and your staff, they comfort me."}]},{"number":46,"verses":[{"number":1,"text":"God is our refuge and strength, a very present help in trouble."}]},{"number":119,"verses":[{"number":105,"text":"Your word is a lamp to my feet, and a light for my path."}]}]},{"number":23,"customName":"Isaiah","name":"Isaiah","abbreviation":"Isa","chapters":[{"number":40,"verses":[{"number":31,"text":"But those who wait for Yahweh will renew their strength. They will mount up with wings like eagles. They will run, and not grow weary. They will walk, and not faint."}]},{"number":53,"verses":[{"number":5,"text":"But he was pierced for our transgressions, he was crushed for our iniquities; the punishment that brought our peace was on him; and by his wounds we are healed."}]}]},{"number":43,"customName":"John","name":"John","abbreviation":"John","chapters":[{"number":1,"verses":[{"number":1,"text":"In the beginning was the Word, and the Word was with God, and the Word was God."}]},{"number":3,"verses":[{"number":16,"text":"For God so loved the world, that he gave his one and only Son, that whoever believes in him should not perish, but have eternal life."}]},{"number":14,"verses":[{"number":6,"text":"Jesus said to him, \"I am the way, the truth, and the life. No one comes to the Father, except through me.\"}]}]},{"number":45,"customName":"Romans","name":"Romans","abbreviation":"Rom","chapters":[{"number":3,"verses":[{"number":23,"text":"for all have sinned, and fall short of the glory of God,"}]},{"number":5,"verses":[{"number":8,"text":"But God commends his own love toward us, in that while we were yet sinners, Christ died for us."}]},{"number":6,"verses":[{"number":23,"text":"For the wages of sin is death, but the free gift of God is eternal life in Christ Jesus our Lord."}]},{"number":8,"verses":[{"number":28,"text":"We know that all things work together for good for those who love God, for those who are called according to his purpose."}]}]},{"number":65,"customName":"1 John","name":"1 John","abbreviation":"1 John","chapters":[{"number":1,"verses":[{"number":9,"text":"If we confess our sins, he is faithful and righteous to forgive us our sins, and to cleanse us from all unrighteousness."}]},{"number":4,"verses":[{"number":8,"text":"He who doesn't love hasn't known God, for God is love."},{"number":19,"text":"We love him, because he first loved us."}]}]},{"number":66,"customName":"Revelation","name":"Revelation","abbreviation":"Rev","chapters":[{"number":21,"verses":[{"number":4,"text":"He will wipe away from them every tear from their eyes. Death will be no more; neither will there be mourning, nor crying, nor pain, any more. The first things have passed away.\"}]}}]}]}