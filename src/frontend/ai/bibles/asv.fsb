["asv","American Standard Version","metadata":{"copyright":"Public Domain"},"books":[{"number":1,"customName":"Genesis","name":"Genesis","abbreviation":"Gen","chapters":[{"number":1,"verses":[{"number":1,"text":"In the beginning God created the heavens and the earth."},{"number":27,"text":"And God created man in his own image, in the image of God created he him; male and female created he them."}]}]},{"number":19,"customName":"Psalms","name":"Psalms","abbreviation":"Ps","chapters":[{"number":23,"verses":[{"number":1,"text":"Jehovah is my shepherd; I shall not want."},{"number":4,"text":"Yea, though I walk through the valley of the shadow of death, I will fear no evil; for thou art with me; thy rod and thy staff, they comfort me."}]},{"number":46,"verses":[{"number":1,"text":"God is our refuge and strength, a very present help in trouble."}]},{"number":119,"verses":[{"number":105,"text":"Thy word is a lamp unto my feet, and a light unto my path."}]}]},{"number":23,"customName":"Isaiah","name":"Isaiah","abbreviation":"Isa","chapters":[{"number":40,"verses":[{"number":31,"text":"But they that wait for Jehovah shall renew their strength; they shall mount up with wings as eagles; they shall run, and not be weary; they shall walk, and not faint."}]},{"number":53,"verses":[{"number":5,"text":"But he was wounded for our transgressions, he was bruised for our iniquities; the chastisement of our peace was upon him; and with his stripes we are healed."}]}]},{"number":43,"customName":"John","name":"John","abbreviation":"John","chapters":[{"number":1,"verses":[{"number":1,"text":"In the beginning was the Word, and the Word was with God, and the Word was God."}]},{"number":3,"verses":[{"number":16,"text":"For God so loved the world, that he gave his only begotten Son, that whosoever believeth on him should not perish, but have eternal life."}]},{"number":14,"verses":[{"number":6,"text":"Jesus saith unto him, I am the way, and the truth, and the life: no one cometh unto the Father, but by me."}]}]},{"number":45,"customName":"Romans","name":"Romans","abbreviation":"Rom","chapters":[{"number":3,"verses":[{"number":23,"text":"for all have sinned, and fall short of the glory of God,"}]},{"number":5,"verses":[{"number":8,"text":"But God commendeth his own love toward us, in that, while we were yet sinners, Christ died for us."}]},{"number":6,"verses":[{"number":23,"text":"For the wages of sin is death; but the free gift of God is eternal life in Christ Jesus our Lord."}]},{"number":8,"verses":[{"number":28,"text":"And we know that to them that love God all things work together for good, even to them that are called according to his purpose."}]},{"number":10,"verses":[{"number":9,"text":"because if thou shalt confess with thy mouth Jesus as Lord, and shalt believe in thy heart that God raised him from the dead, thou shalt be saved:"}]},{"number":46,"customName":"1 Corinthians","name":"1 Corinthians","abbreviation":"1 Cor","chapters":[{"number":13,"verses":[{"number":4,"text":"Love suffereth long, and is kind; charity envieth not; charity vaunteth not itself, is not puffed up,"},{"number":5,"text":"doth not behave itself unseemly, seeketh not its own, is not easily provoked, taketh not account of evil;"},{"number":7,"text":"rejoiceth not in unrighteousness, but rejoiceth with the truth; beareth all things, believeth all things, hopeth all things, endureth all things."}]}]},{"number":50,"customName":"Philippians","name":"Philippians","abbreviation":"Phil","chapters":[{"number":4,"verses":[{"number":13,"text":"I can do all things in him that strengtheneth me."}]}]},{"number":65,"customName":"1 John","name":"1 John","abbreviation":"1 John","chapters":[{"number":1,"verses":[{"number":9,"text":"If we confess our sins, he is faithful and righteous to forgive us our sins, and to cleanse us from all unrighteousness."}]},{"number":4,"verses":[{"number":8,"text":"He that loveth not knoweth not God; for God is love."},{"number":19,"text":"We love, because he first loved us."}]}]},{"number":66,"customName":"Revelation","name":"Revelation","abbreviation":"Rev","chapters":[{"number":21,"verses":[{"number":4,"text":"and he shall wipe away every tear from their eyes; and there shall be no more death, neither sorrow, nor crying, neither shall there be any more pain: for the first things are passed away."}]}]}]}